{
  "name": "destino",
  "version": "0.2.5",
  "description": "Doom terminal demo based on Node.js, doomgeneric and Kitty Graphics",
  "homepage": "https://github.com/platformatic/destino",
  "author": "Platformatic Inc. <oss@platformatic.dev> (https://platformatic.dev)",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/destino.git"
  },
  "keywords": [
    "doom",
    "doomgeneric",
    "freedoom",
    "kitty"
  ],
  "bugs": {
    "url": "https://github.com/platformatic/destino/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --no-warnings src/index.js",
    "build": "node ./src/scripts/build.js",
    "lint": "eslint --cache",
    "clean": "rm -rf dist tmp",
    "distclean": "rm -rf deps dist tmp",
    "format": "prettier -w src && clang-format -i src/native/main.c src/native/audio.c",
    "prepare": "node --no-warnings ./src/scripts/dependencies.js",
    "notarize:mac": "bash ./src/scripts/notarize-macos.sh",
    "sea": "node ./src/scripts/sea.js"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "neostandard": "^0.12.2",
    "prettier": "^3.8.1",
    "prettier-plugin-space-before-function-paren": "^0.0.10",
    "rolldown": "1.0.0-rc.17",
    "semver": "^7.7.4"
  },
  "engines": {
    "node": ">=26.10.0"
  }
}
